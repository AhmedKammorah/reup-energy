# Payload secret — used to sign tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# Database adapter — leave SQLite for local dev. Switch to Postgres for prod.
# SQLite (default for dev)
DATABASE_URI=file:./reup-landing.db

# Postgres (uncomment for prod / staging — Neon / Supabase / RDS / Fly Postgres)
# DATABASE_URI=postgres://user:pass@host:5432/reup_landing

# Public site URL (used for absolute links + admin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: comma-separated CORS / CSRF origins for the API
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
